# World Monitor — minimal self-host configuration

# Core services
DATABASE_URL=postgresql://worldmonitor:worldmonitor@postgis:5432/worldmonitor
VITE_COMPOUND_API_URL=http://localhost:8090
VITE_PLANNER_API_URL=http://localhost:8091

# Optional LLM summarization
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=

# Google Weather hazards (compound-api production path)
GOOGLE_WEATHER_API_KEY=
GOOGLE_WEATHER_BASE_URL=https://weather.googleapis.com/v1
HAZARD_GRID_KM=25
HAZARD_MAX_POINTS=300
HAZARD_CACHE_TTL_MIN=60
WIND_THRESHOLD_KPH=50
WIND_MAX_KPH=120
RAIN_THRESHOLD_MM_HR=10
RAIN_MAX_MM_HR=50
HEAT_THRESHOLD_C=38
HEAT_MAX_C=48
FORECAST_HOURS=72
TIMESTEP_HOURS=0,6,12,24,48,72
DEFAULT_BBOX=72.0,8.0,88.0,23.0
MAX_BBOX_AREA_DEG2=50
MAX_QPS=5
EVENT_LOOKBACK_HOURS=72
ALERT_SCORE_THRESHOLD=20
EVENT_TYPE_WEIGHTS_JSON={"PROTEST":1.2,"STRIKE":1.2,"CONFLICT":1.5,"DISASTER":1.4,"OUTAGE":1.3,"ACCIDENT":1.1,"OTHER":1.0}

# Events ingestor
GDELT_ENABLED=true
RELIEFWEB_ENABLED=true
RSS_ENABLED=false
RSS_CONFIG_PATH=/app/config/rss_feeds.yml
INGEST_INTERVAL_MINUTES=15
FOCUS_COUNTRIES=IN,AE,GB,US
FOCUS_REGIONS=EUROPE

# Optional event/intel sources
ACLED_ACCESS_TOKEN=
CLOUDFLARE_API_TOKEN=
NASA_FIRMS_API_KEY=

# Optional map tile provider key (if required by your tile source)
MAP_TILES_API_KEY=
