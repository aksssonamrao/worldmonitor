# World Monitor — minimal self-host configuration

# Required core services
POSTGRES_PASSWORD=worldmonitor
DATABASE_URL=postgresql://worldmonitor:worldmonitor@postgis:5432/worldmonitor
VITE_COMPOUND_API_URL=http://localhost:8090
VITE_PLANNER_API_URL=http://localhost:8091
COMPOUND_API_URL_BACKEND=http://compound_api:8090

# Optional LLM summarization
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=

# Google Weather hazards (required by compound_api)
GOOGLE_WEATHER_API_KEY=
GOOGLE_WEATHER_BASE_URL=https://weather.googleapis.com/v1
HAZARD_GRID_KM=25
HAZARD_MAX_POINTS=300
HAZARD_CACHE_TTL_MIN=60
WIND_THRESHOLD_KPH=50
WIND_MAX_KPH=120
RAIN_THRESHOLD_MM_HR=10
RAIN_MAX_MM_HR=50
HEAT_THRESHOLD_C=38
HEAT_MAX_C=48
FORECAST_HOURS=72
TIMESTEP_HOURS=0,6,12,24,48,72
DEFAULT_BBOX=72.0,8.0,88.0,23.0
MAX_BBOX_AREA_DEG2=50
MAX_QPS=5
EVENT_LOOKBACK_HOURS=72
ALERT_SCORE_THRESHOLD=20
EVENT_TYPE_WEIGHTS_JSON={"PROTEST":1.2,"STRIKE":1.2,"CONFLICT":1.5,"DISASTER":1.4,"OUTAGE":1.3,"ACCIDENT":1.1,"OTHER":1.0}

# Ingestor scheduling and provider resilience
INGEST_INTERVAL_MINUTES=15
MONITORING_INTERVAL_MINUTES=30
PROVIDER_CONNECT_TIMEOUT_SECONDS=5.0
PROVIDER_READ_TIMEOUT_SECONDS=20.0
PROVIDER_MAX_RETRIES=3
PROVIDER_BACKOFF_BASE_SECONDS=0.5
PROVIDER_BACKOFF_MAX_SECONDS=8.0
PROVIDER_BACKOFF_JITTER_SECONDS=0.25
PROVIDER_RATE_LIMIT_PER_SECOND=5.0
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
PROVIDER_CIRCUIT_COOLDOWN_SECONDS=60
PROVIDER_CACHE_TTL_SECONDS=1800
PROVIDER_MAX_STALE_SECONDS=10800

# Dedup
DEDUP_TIME_WINDOW_HOURS=6
DEDUP_RADIUS_KM_DISASTER=200
DEDUP_RADIUS_KM_CONFLICT=150
DEDUP_RADIUS_KM_PROTEST=50
DEDUP_RADIUS_KM_OUTAGE=50
SIMHASH_STRONG_MAX_DIST=12
SIMHASH_AMBIGUOUS_MAX_DIST=18
EMBEDDINGS_ENABLED=false
EMBEDDINGS_COSINE_THRESHOLD=0.86
GEOHASH_PRECISION=6
TIME_BUCKET_MINUTES=60

# Providers
GDELT_ENABLED=true
RELIEFWEB_ENABLED=true
RELIEFWEB_APPNAME=your_preapproved_appname
RSS_ENABLED=false
RSS_CONFIG_PATH=/app/config/rss_feeds.yml
USGS_ENABLED=true
USGS_MIN_MAGNITUDE=4
FIRMS_ENABLED=false
FIRMS_MAP_KEY=
PLANNED_ENABLED=true
PLANNED_DISRUPTIONS_PATH=/app/config/planned_disruptions.yml
FOCUS_COUNTRIES=IN,AE,GB,US
FOCUS_REGIONS=EUROPE

# Nominatim (dev only)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=worldmonitor/0.1 (contact: you@example.com)
NOMINATIM_ENABLE_AUTOCOMPLETE=false

# Optional map tile provider key (if required by your tile source)
MAP_TILES_API_KEY=
